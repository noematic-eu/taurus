{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Taurus",
  "version": "0.2.0",
  "identifier": "eu.noematic.taurus",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Taurus",
        "width": 560,
        "height": 420
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["zip"],
        "name": "Zip website pack",
        "mimeType": "application/zip",
        "role": "Viewer"
      },
      {
        "ext": ["wacz"],
        "name": "WACZ web archive",
        "role": "Viewer"
      },
      {
        "ext": ["warc", "warc.gz"],
        "name": "WARC web archive",
        "mimeType": "application/warc",
        "role": "Viewer"
      }
    ]
  }
}
